# ==============================================================================
# CareOS Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# .env.local is ignored by Git and will remain secure on your machine.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend (PostgreSQL, Auth, RLS, Realtime)
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Project Public Anon Key (safe for client-side browser use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Project Service Role Key (SECRET: Used strictly in server route handlers for admin tasks)
# NEVER share or prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API (CareVoice Assistant)
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 3. Environment & Demo Mode
# - "true"  : Shows the Development Fixture banner & allows 1-click test personas
# - "false" : Strict production mode with zero mock data and clean authentic state
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=true
